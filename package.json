{
  "name": "lowpoly-city",
  "private": true,
  "version": "1.5.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tricount": "esbuild tools/tricount.ts --bundle --platform=node --format=esm --outfile=/tmp/tri.mjs --log-level=error && node /tmp/tri.mjs",
    "test:industry": "esbuild tools/industry.test.ts --bundle --platform=node --format=esm --outfile=/tmp/industry-test.mjs --log-level=error && node /tmp/industry-test.mjs",
    "test:v15b": "esbuild tools/v15b.test.ts --bundle --platform=node --format=esm --outfile=/tmp/v15b-test.mjs --log-level=error && node /tmp/v15b-test.mjs",
    "test:v15": "esbuild tools/v15.test.ts --bundle --platform=node --format=esm --outfile=/tmp/v15-test.mjs --log-level=error && node /tmp/v15-test.mjs",
    "test:cells": "esbuild tools/cells.test.ts --bundle --platform=node --format=esm --outfile=/tmp/cells-test.mjs --log-level=error && node /tmp/cells-test.mjs",
    "test:v15b-res": "esbuild tools/v15b-res.test.ts --bundle --platform=node --format=esm --outfile=/tmp/v15b-res-test.mjs --log-level=error && node /tmp/v15b-res-test.mjs",
    "balance": "esbuild tools/balance.ts --bundle --platform=node --format=esm --outfile=/tmp/balance.mjs --log-level=error && node /tmp/balance.mjs",
    "bench": "esbuild tools/bench/bench-tick.ts --bundle --platform=node --format=esm --outfile=/tmp/bench.mjs --log-level=error && node --expose-gc /tmp/bench.mjs",
    "bench:check": "esbuild tools/bench/bench-tick.ts --bundle --platform=node --format=esm --outfile=/tmp/bench.mjs --log-level=error && node --expose-gc /tmp/bench.mjs --check",
    "test:mapsize": "esbuild tools/mapsize.test.ts --bundle --platform=node --format=esm --outfile=/tmp/mapsize-test.mjs --log-level=error && node /tmp/mapsize-test.mjs",
    "test:chunks": "esbuild tools/chunks.test.ts --bundle --platform=node --format=esm --outfile=/tmp/chunks-test.mjs --log-level=error && node /tmp/chunks-test.mjs",
    "test:incremental": "esbuild tools/incremental.test.ts --bundle --platform=node --format=esm --outfile=/tmp/incremental-test.mjs --log-level=error && node /tmp/incremental-test.mjs",
    "test:replay": "esbuild tools/replay.test.ts --bundle --platform=node --format=esm --outfile=/tmp/replay-test.mjs --log-level=error && node /tmp/replay-test.mjs",
    "test:regions": "esbuild tools/regions.test.ts --bundle --platform=node --format=esm --outfile=/tmp/regions-test.mjs --log-level=error && node /tmp/regions-test.mjs",
    "test:roadgraph": "esbuild tools/roadgraph.test.ts --bundle --platform=node --format=esm --outfile=/tmp/roadgraph-test.mjs --log-level=error && node /tmp/roadgraph-test.mjs",
    "test:blocks": "esbuild tools/blocks.test.ts --bundle --platform=node --format=esm --outfile=/tmp/blocks-test.mjs --log-level=error && node /tmp/blocks-test.mjs",
    "test:blockbridge": "esbuild tools/blockbridge.test.ts --bundle --platform=node --format=esm --outfile=/tmp/blockbridge-test.mjs --log-level=error && node /tmp/blockbridge-test.mjs",
    "test:gtraffic": "esbuild tools/gtraffic.test.ts --bundle --platform=node --format=esm --outfile=/tmp/gtraffic-test.mjs --log-level=error && node /tmp/gtraffic-test.mjs",
    "test:utilities": "esbuild tools/utilities.test.ts --bundle --platform=node --format=esm --outfile=/tmp/utilities-test.mjs --log-level=error && node /tmp/utilities-test.mjs"
  },
  "dependencies": {
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/three": "^0.169.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}
